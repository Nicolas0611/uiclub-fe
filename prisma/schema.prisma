
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
        

enum Popularity {
  HIGH
  MEDIUM
  LOW
}

enum Types {
  Overlays
  Data
  Input
  Status
  Navigation
  Loading
  Messaging
  Action
  Images
  Layout
  Form
}

enum Role {
  admin
  user
}

model User {
  id String @id @default(uuid())
  name String
  email String @unique
  emailVerified DateTime?
  password String
  role Role @default(user)
  image String?
  //Relations
}



model Company {
  id                  Int             @id @default(autoincrement())
  dateCreated         DateTime        @default(now())
  state               Boolean         @default(true)
  name                String          @db.VarChar(255)


  // 1:1 relation
  designSystem        DesignSystem?
  figma               Figma[]

  companyImage        CompanyImage?   @relation(fields: [companyImageId], references: [id])
  companyImageId      String?         @unique
  
}

model DesignSystem {
  id                  String          @id @default(uuid())
  dateCreated         DateTime        @default(now())
  state               Boolean         @default(true)
  name                String          @db.VarChar(255)
  popularity          Popularity    
  isUpdated           Boolean
  shortDescription    String          @db.VarChar(255)
  largeDescription    String          
  slug                String          @db.VarChar(50)
  isNew               Boolean

  //Relations 
  company             Company         @relation(fields: [companyId], references: [id])
  companyId           Int             @unique

  companyImage        CompanyImage?   @relation(fields: [companyImageId], references: [id])
  companyImageId      String?         @unique

  components          Component[]

  componentTypes      DesignSystemComponentType[]

  links               Link?
}

model Link {
  id                   Int            @id @default(autoincrement())
  state                Boolean        @default(true)
  dateCreated          DateTime       @default(now())
  figma                String?        @db.VarChar(200)
  web                  String?        @db.VarChar(200)
  storybook            String?        @db.VarChar(200)

  //Relations 
  designSystem         DesignSystem   @relation(fields: [designSystemId], references: [id])
  designSystemId       String         @unique
}

model Component {
  id                  String          @id @default(uuid())
  dateCreated         DateTime        @default(now())
  state               Boolean         @default(true)
  name                String          @db.VarChar(255)
  description         String
  type                Types
  link                String          @db.VarChar(255)

  //Relations 
  designSystem        DesignSystem    @relation(fields: [designSystemId], references: [id])
  designSystemId      String          
}

model ComponentType {
  id                    String          @id @default(uuid())
  dateCreated           DateTime        @default(now())
  state                 Boolean         @default(true)
  name                  String          @db.VarChar(255)
  description           String?          
  type                  Types
  usageCount            Int             @default(0)
  implementationsCount  Int             @default(0)
  designSystemCount     Int             @default(0)
  link                  String?          @db.VarChar(255)
  

  //Relations 
  relatedDesignSystems  DesignSystemComponentType[]
  figmaLinks            Figma[]

}

model DesignSystemComponentType {
  designSystem   DesignSystem  @relation(fields: [designSystemId], references: [id])
  designSystemId String

  componentType  ComponentType @relation(fields: [componentTypeId], references: [id])
  componentTypeId String

  @@id([designSystemId, componentTypeId])
}

model Figma {
    id                    String          @id @default(uuid())
    dateCreated           DateTime        @default(now())
    state                 Boolean         @default(true)
    url                   String          @db.VarChar(200)
  
    //Relations 
    company               Company         @relation(fields: [companyId], references: [id])
    companyId             Int  

    componentType         ComponentType   @relation(fields: [componentTypeId], references: [id])
    componentTypeId       String              
}

model CompanyImage {
  id                  String              @id @default(uuid())
  dateCreated         DateTime            @default(now())
  state               Boolean             @default(true)
  url                 String              @db.VarChar(255)  
  name                String              @db.VarChar(100)
  
  // 1:1 relation
  designSystem DesignSystem?
  company Company?
  
}
